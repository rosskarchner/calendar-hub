# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
DATABASE_URL=postgresql://calendar_user:calendar_pass@localhost:5432/calendar_hub

# GitHub OAuth Configuration
# Register a GitHub OAuth App at https://github.com/settings/developers
# Set Authorization callback URL to: http://localhost:5000/auth/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# AWS Configuration (for newsletter functionality)
# You need AWS credentials configured via AWS CLI or IAM role
# The application uses boto3 which will automatically use your AWS credentials
AWS_REGION=us-east-1
SENDER_EMAIL=outgoing@example.com
CONFIRMATION_KEY_ID=your-kms-key-id-here

# Domain Configuration
DOMAIN_NAME=localhost:5000
